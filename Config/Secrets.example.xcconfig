// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Analytics are only sent from Release builds, so Debug runs don't mix test data into PostHog.
DX_POSTHOG_API_KEY_RELEASE = phc_your_project_key
// US cloud. For EU use https:/$()/eu.i.posthog.com
DX_POSTHOG_HOST = https:/$()/us.i.posthog.com
